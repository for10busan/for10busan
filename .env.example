# 서버 포트
PORT=3000
# 데이터(DB·영상) 저장 위치 — 서버를 옮겨도 이 폴더만 있으면 그대로 복원돼요
DATA_DIR=./data
# (선택) 비워 두면 처음 실행할 때 자동으로 만들어 저장해요
# APP_SECRET=
# 처음 실행할 때 만들어지는 원장 계정
ADMIN_EMAIL=admin@for10.kr
ADMIN_PASSWORD=
ADMIN_NAME=원장
BRANCH_NAME=부산교육원
# 영상 최대 크기(MB)
MAX_VIDEO_MB=300
# (선택) MediaPipe 파일을 직접 호스팅할 때
# MEDIAPIPE_BASE=/vendor/mediapipe
# MEDIAPIPE_MODEL=/vendor/mediapipe/pose_landmarker_full.task
